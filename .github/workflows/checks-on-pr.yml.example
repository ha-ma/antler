# 検査（local-ci --ci）— PR で自動実行する版。既定では有効にしていない（拡張子が .example）。
#
# 使うとき: このファイルを checks-on-pr.yml に改名する。checks.yml（手動のみ）と併用しなくてよい。
# Actions の無料枠（分数）を使う。PR ごとに全部の検査を回すので、課金を抑えたい案件は
# 手動実行（checks.yml）のままにして、手元の記録を主にする。
#
# 検査の一覧は local_ci_checks.toml の 1 か所（ここには検査のコマンドを書かない）。
name: Checks on PR (local-ci --ci)

on:
  pull_request:

concurrency:
  group: checks-${{ github.ref }}
  cancel-in-progress: true

jobs:
  checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0  # 比較元との差分を取る検査があるため
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      # ↓ 案件に合わせる: 検査が使う道具を入れる。--ci では、道具が無くて見送られた検査は fail になる。
      - run: pip install -e ".[dev]"
      # Node の案件（react など）: 検査を回す local-ci 自体が Python で動くので setup-python は残し、
      # 上の pip の行を依存の入れ方（npm ci など）に変えて、setup-node を足す:
      # - uses: actions/setup-node@v4
      #   with:
      #     node-version: 22
      # - run: npm ci
      - name: Run checks
        run: python scripts/local-ci.py --ci
