{
  "$id": "https://antler.local/schema/client-message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ack"
        },
        "t_shown": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))(?!\\n)$"
            },
            {
              "type": "string",
              "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))(?!\\n)$"
            }
          ]
        }
      },
      "required": [
        "type",
        "t_shown"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "label"
        },
        "value": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vehicle"
        },
        "speedKmh": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "zone": {
          "type": "string",
          "enum": [
            "inside",
            "outside"
          ]
        },
        "light": {
          "type": "string",
          "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "title": "VehicleMessage"
    }
  ]
}
