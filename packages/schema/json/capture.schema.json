{
  "$id": "https://antler.local/schema/capture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9]+$"
    },
    "source": {
      "type": "string",
      "enum": [
        "sim",
        "vehicle"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_/-]+\\.(?:jpg|jpeg|png)$"
    },
    "imageSize": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "const": "deer"
          },
          "xywh": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "by": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ]
          }
        },
        "required": [
          "label",
          "xywh",
          "by"
        ],
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "season": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "weather": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "surface": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "light": {
          "type": "string",
          "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        },
        "fog": {
          "type": "string",
          "enum": [
            "none",
            "light",
            "medium",
            "heavy"
          ]
        },
        "traffic": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "vehicle": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        }
      },
      "required": [
        "season",
        "month",
        "weather",
        "surface",
        "light",
        "fog",
        "traffic",
        "vehicle"
      ],
      "additionalProperties": false
    },
    "distanceM": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "side": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "L",
            "R"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pose": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "reactionMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "avoided",
        "collided",
        "missed"
      ]
    },
    "roadSegment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "consent": {
      "type": "boolean"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "string",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      ]
    }
  },
  "required": [
    "id",
    "source",
    "image",
    "imageSize",
    "boxes",
    "conditions",
    "distanceM",
    "side",
    "pose",
    "reactionMs",
    "outcome",
    "roadSegment",
    "consent",
    "createdAt"
  ],
  "additionalProperties": false
}
