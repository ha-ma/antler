# apps/api の環境変数の見本。コピーして .env を作る（.env はコミットしない）。
# 足りない・形が違う値があると起動しない（src/infrastructure/config/env.ts）。

# development / test / production。未設定は production（エラーの detail を応答に出さない側）。
# detail（例外のメッセージ）を応答に出すのは development だけ。npm run dev は development を付けて起動する
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# 許可するオリジンをカンマ区切りで。* は使えない
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# POST /api/trips（plan-trip）
# Claude の API キー。必須（無ければ起動しない。既定値なし）。
# アプリの上限が破れても止まるように、Anthropic のコンソール側にも支出の上限を設定しておく
ANTHROPIC_API_KEY=
# 所有者トークン（HMAC-SHA256）の秘密。必須・32 文字以上・既定値なし。例: openssl rand -hex 32
# 変えると発行済みの所有者トークンがすべて使えなくなる
OWNER_TOKEN_SECRET=
# 1 日（日本時間の暦日）の Claude の呼び出しの上限。作り直しの 1 回・失敗した呼び出しも数える。
# 超えたら 429 DAILY_LIMIT。既定 400 は「旅 200 件 × 呼び出し 2 回（最初と作り直し）」
# A-6 の喪失文（POST /api/trips/:id/losses、loss）も同じ数え上げで数える（保存済みの文を返すときは数えない）
CLAUDE_DAILY_CALL_LIMIT=400
# Claude の同時呼び出しの上限（plan-trip と loss で共有）。超えたら 503 WRITER_BUSY
CLAUDE_MAX_CONCURRENT_CALLS=4
# 旅を保存する SQLite のデータファイル（フォルダは起動時に作る。apps/api/data/ は .gitignore 済み）
# Vercel では Turso の URL（libsql://<db>-<org>.turso.io）。file: は使えない（docs/runbooks/2026-11-05-deploy-a-vercel-turso.md）
TRIPS_DB_URL=file:./data/trips.db
# Turso の DB のトークン（秘密・既定値なし）。TRIPS_DB_URL が libsql:// / https:// のときだけ要る。file: なら空のまま
# Vercel では Sensitive の環境変数にする。Production と Preview で別の DB・別のトークン
TURSO_AUTH_TOKEN=

# 旅の記録（record。docs/specs/record/functional.md R1・R6）
# 共有する記録の URL（/t/{id}）・OG 画像・リンクは、この値だけから作る（要求の Host ヘッダは使わない）。
# 本番では必ず公開の URL にする（既定は開発用の localhost）。sim の VITE_API_BASE_URL と同じ api を指す
PUBLIC_API_URL=http://localhost:8787
# sim（A-7 の操作できる画面・A-1）の公開のオリジン
SIM_PUBLIC_URL=http://localhost:5173
# PWA（B-0。A-7 の「車載アラートについて」の行き先）の公開のオリジン
PWA_PUBLIC_URL=http://localhost:5174
# OG 画像（しおりの PNG）のフォントのファイル（カンマ区切り）。空ならシステムのフォントを使う。
# Linux のサーバーでは日本語・中国語・韓国語のフォントが無いと文字が四角になるので、
# fonts-noto-cjk を入れるか、Noto Sans CJK のファイルをここに書く
OG_FONT_FILES=

# TRUST_PROXY: レート制限（IP あたり 1 分 10 件。IPv6 は /64 で 1 つ）の鍵にする IP の取り方。
# - false（既定）: TCP の接続元を使う。X-Forwarded-For は無視する。api を直接インターネットに出すときはこれ
# - true: X-Forwarded-For の「右端」を使う。リバースプロキシ（Cloudflare・ロードバランサー・nginx など）が
#   ちょうど 1 段あり、そのプロキシが X-Forwarded-For の末尾に接続元を付け足すときだけ true にする
# 注意:
# - プロキシの後ろなのに false のままだと、全員がプロキシの IP 1 つの枠を分け合い、正規の利用者が 429 になる
# - プロキシが無いのに true にすると、右端は利用者が自由に書けるので、要求ごとに枠を増やされる
# - プロキシが 2 段以上（例: CDN → LB → api）のときの右端は手前のプロキシの IP になる。
#   手前のプロキシに X-Forwarded-For を書き換えさせる（例: nginx の real_ip）か、段を 1 つにしてから true にする
# - api のポートはプロキシからだけ届くようにする（直接届くと X-Forwarded-For を偽装できる）
# - Vercel ではこの値を読まない。関数は Vercel が付けるヘッダ（x-vercel-forwarded-for → x-real-ip → x-forwarded-for の右端）
#   から取る（Vercel は X-Forwarded-For を接続元の IP 1 つで上書きする）
# - Vercel ではレート制限の数えは Turso の rate_limit_hits（鍵は HMAC で、IP を置かない）
TRUST_PROXY=false

# POST /api/captures（edge-capture。PWA / sim が同意済みの検知フレームを送る口。認証なし・IP あたり 1 分 60 件）
# 受け取った Capture の JSON と画像の置き場所（起動時に 0700 で作る。.gitignore 済み。dataset/ がここを直接読む）
CAPTURES_DIR=./data/captures-received
# 保存件数の上限。以上になると 503 STORE_FULL
CAPTURES_MAX_ITEMS=50000
# 保存した画像の合計の上限（バイト。既定 5 GiB = 5368709120）。以上になると 503 STORE_FULL
# Vercel では小さくする（手順書: Production 5000 件・1 GiB、Preview 500 件・100 MiB）
CAPTURES_MAX_BYTES=5368709120

# --- Vercel の上だけ（deploy-a。手元の npm run dev では使わない） ---
# Capture の画像は Vercel Blob（非公開のストア）に置く。CAPTURES_DIR は使わない
# - Vercel の上: Blob のストアをプロジェクトにつなぐと BLOB_STORE_ID が付き、SDK が OIDC（VERCEL_OIDC_TOKEN）で読み書きする
# - 手元から Blob を触るときだけ BLOB_READ_WRITE_TOKEN（秘密）を使う
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# PUBLIC_API_URL・SIM_PUBLIC_URL・CORS_ORIGINS を書かなければ、Vercel の値から作る:
#   Production は https://<VERCEL_PROJECT_PRODUCTION_URL>、Preview は https://<VERCEL_BRANCH_URL>（無ければ VERCEL_URL）
# マイグレーション（表を作る）はデプロイの前に手元から 1 回:
#   npm run db:migrate -w @antler/api -- --env-file .env.turso-production
