{
  "name": "@antler/api",
  "private": true,
  "version": "0.0.0",
  "description": "SHIKASHI SIMULATOR（A）の API（Hono）",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "db:migrate": "tsx src/infrastructure/commands/migrate-db.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@antler/alert-ui": "^0.0.0",
    "@antler/i18n-check": "^0.0.0",
    "@antler/schema": "^0.0.0",
    "@antler/trip": "^0.0.0",
    "@antler/zones": "^0.0.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
