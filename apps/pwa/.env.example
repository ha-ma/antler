# 開発中（npm run dev）はアラートの音（チャイム・ビープ・読み上げ）を出さない。鳴らして確かめたいときだけ on にする。
# 本番ビルドでは、この値に関係なく常に鳴る。
VITE_ALERT_SOUND=off

# 走行後の同意（edge-capture）の送り先。コメントアウトのままなら、走行後の同意画面は出ない。
# VITE_API_BASE_URL=http://localhost:8804

# 車内の edge（Mac mini）のホスト（カンマ区切り、最大 8 件。docs/specs/pwa-https）。本番ビルドの CSP と接続先に入る。
# 既定は ezoroad.local。車の AP の IP を足してビルドする（手順は docs/runbooks/2026-11-06-pwa-https.md）。
# VITE_EDGE_HOSTS=ezoroad.local,192.168.2.1
