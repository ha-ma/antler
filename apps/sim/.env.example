# apps/sim の環境変数の見本。コピーして .env.local を作る（コミットしない）。VITE_ で始まる値はブラウザに公開される。
VITE_API_BASE_URL=http://localhost:8787
# 開発中（npm run dev）はアラートの音（チャイム・ビープ・読み上げ）を出さない。鳴らして確かめたいときだけ on にする。
# 本番ビルドでは、この値に関係なく常に鳴る。
VITE_ALERT_SOUND=off
# 運転の音（エンジン・ブレーキ・ラジオ・会話の通知音）も、開発中は既定で鳴らさない。鳴らして確かめたいときだけ on にする。
# 本番ビルドでは、この値に関係なく鳴る（利用者は運転画面の音量のつまみで消せる）。
VITE_GAME_AUDIO=off
# A-2 の地図の背景（MapLibre のスタイル URL）。空なら OpenFreeMap の positron（キー不要）。
# 回線の無いデモでは off にすると、背景なしでルートと鹿ゾーンだけを出す。本番ビルドの CSP はこの URL の origin を許す。
VITE_MAP_STYLE_URL=
# A-7 の「車載アラートについて」の行き先（B-0、PWA の公開の URL）。空なら開発の http://localhost:5174
VITE_PWA_URL=
