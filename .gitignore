# 依存・ビルド
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
# A API の開発用データ（SQLite・保存先）
apps/api/data/
# POST /api/captures が受け取った Capture と画像（同意済みの匿名データ。コミットしない）
data/captures-received/

# Vercel の CLI（vercel link・vercel build の出力。プロジェクトの ID と環境変数の写しが入る）
.vercel/

# 秘密
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account.json

# Claude Code（個人設定とログ）
.claude/settings.local.json
.claude/logs/
# hook が作業ディレクトリごとに作るログ（apps/sim/.claude/logs など）
**/.claude/logs/

# local-ci の記録（コミットしない）
.claude/state/

# B: モデルの重みと走行の生データ（同意・匿名化の前のものを公開リポジトリに入れない）
edge/**/models/
*.mlpackage/
*.mlmodel
*.pt
*.onnx
edge/**/runs/
dataset/raw/
# 外部の公開データ（Commons の実写フレームなど）。大きいので入れない。置き場所と取得方法は dataset/README.md
dataset/external/
# 配布できない参考写真（評価と 3D の参考だけに使う。学習データにしない。2026-11-04 ユーザー判断、ch9 ③）
dataset/private/

.DS_Store

# zones の生成に使う道路データ（国の配布サイトから取得。リポジトリに入れない）
packages/zones/data/cache/

# L1 の校正の生成物（edge-l1-calibration）。合成で学んだ温度が実機に残ると偽の温度で赤が下がるので入れない
dataset/out/
edge/detector/calibration.json

# edge-capture: 車載で保存した検知フレーム（同意の前の実走行の画像。リポジトリに入れない）
edge/detector/captures/
