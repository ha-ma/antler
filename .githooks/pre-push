#!/bin/sh
# pre-push: 押す内容に対する検査の記録が無ければ止める。
# git は標準入力に「<local ref> <local sha> <remote ref> <remote sha>」を渡す。
# それをそのまま local-ci.py --pre-push へ流す（HEAD ではなく、押す sha で判定する）。
#
# 限界: clone では有効にならない（scripts/setup.sh が core.hooksPath を設定する）。
#       git push --no-verify で飛ぶ。記録の嘘（回さずに記録だけ作る）は止められない。
set -eu
root="$(git rev-parse --show-toplevel)"

# 飛ばすときは必ず理由を出す（沈黙を成功にしない）
if [ ! -f "$root/scripts/local-ci.py" ]; then
  echo "pre-push: scripts/local-ci.py が無いので検査の確認を飛ばします" >&2
  exit 0
fi
py=python
command -v python >/dev/null 2>&1 || py=python3
if ! command -v "$py" >/dev/null 2>&1; then
  echo "pre-push: python が無いので検査の確認を飛ばします" >&2
  exit 0
fi

if "$py" "$root/scripts/local-ci.py" --pre-push; then
  exit 0
fi
cat >&2 <<'MSG'
------------------------------------------------------------
  この差分に対する検査の記録が無い（または合っていない）ため push を止めました。
      python scripts/local-ci.py
  を実行してから push してください。
  ※ 記録の嘘（回さずに記録だけ作る）はこの仕組みでは止められません。止めるのは CI の回し直しです。
------------------------------------------------------------
MSG
exit 1
